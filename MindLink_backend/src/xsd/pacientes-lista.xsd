<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- ─── Root ─────────────────────────────────────────────────────────────── -->
  <xs:element name="PacientesExport">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="GeradoEm" type="xs:dateTime"/>
        <xs:element name="Psicologo" type="PsicologoResumoType"/>
        <xs:element name="Pacientes">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Paciente" type="PacienteResumoType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="PsicologoResumoType">
    <xs:sequence>
      <xs:element name="Id" type="xs:string"/>
      <xs:element name="Nome" type="xs:string"/>
      <xs:element name="Especialidade" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PacienteResumoType">
    <xs:sequence>
      <xs:element name="Id" type="xs:string"/>
      <xs:element name="Nome" type="xs:string"/>
      <xs:element name="Email">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[^@\s]+@[^@\s]+\.[^@\s]+"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="DataNascimento" type="xs:date"/>
      <xs:element name="Doenca" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
